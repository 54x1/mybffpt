{
  "name": "mybffpt",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite --open index.html",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "unit": "vitest run",
    "unit:watch": "vitest",
    "unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "a11y": "playwright test tests/e2e/a11y.spec.ts",
    "license:check": "node scripts/check-license-headers.mjs",
    "license:deps": "license-checker-rseidelsohn --summary --excludePrivatePackages",
    "license:notices": "node scripts/generate-third-party-notices.mjs",
    "license:notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "security:audit": "npm audit --audit-level=high",
    "verify": "npm run type-check && npm run unit && npm run license:check && npm run license:notices:check && npm run build && npm run security:audit && npm run a11y"
  },
  "keywords": [],
  "author": "54x1",
  "license": "AGPL-3.0-or-later",
  "description": "mybffpt | myBudget Forecaster — Personal Finance Tracker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/54x1/mybffpt.git"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "d3": "^7.9.0",
    "daisyui": "^4.12.24",
    "vue": "^3.5.41",
    "vue-chartjs": "^5.3.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "nanoid": ">=3.3.18"
  }
}
